# Copy this file to .env and fill in values before running docker compose.

# Network interface for live capture. Leave blank for PCAP-ingest-only mode.
PCAP_IFACE=

# Malcolm web interface port (default 443).
MALCOLM_PORT=443

# OpenSearch memory. Should be roughly half of available RAM.
# Format: <number>g  (e.g. 8g for 8 GB)
OPENSEARCH_HEAP=8g

# Retention: how many days of logs to keep before rolling.
LOG_RETENTION_DAYS=30

# Authentication (set during install.py; change here to override)
MALCOLM_USERNAME=analyst
# MALCOLM_PASSWORD is hashed — run scripts/auth_setup.sh to change it
